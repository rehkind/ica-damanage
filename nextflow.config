manifest {
    name        = 'ica-wgs-delivery'
    description = 'Collect VCF, TSV and CSV outputs in an ICA connector folder'
    version     = '1.0.0'
    nextflowVersion = '>=24.04.0'
}

process {
    withName: COPY_SELECTED_FILE {
        cpus   = 1
        memory = '512 MB'
        time   = '2h'
    }

    withName: WRITE_MANIFEST {
        cpus   = 1
        memory = '256 MB'
        time   = '15m'
    }
}
